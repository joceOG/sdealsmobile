<?xml version="1.0" encoding="utf-8"?>
<!-- Fond blanc + soutra_splash centré — gravity center (pas fill = pas de déformation) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <!-- Même emprise que BrandIntroConfig.logoMaxWidth (168). -->
    <item
        android:width="168dp"
        android:height="168dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/soutra_splash" />
    </item>
</layer-list>
