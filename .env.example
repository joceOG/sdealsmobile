# Ne jamais committer de vrais secrets.
# En local : renseigner API_URL (HTTPS en prod, jamais d'IP LAN shippable).
# En CI/release : préférer
#   flutter build apk --dart-define=API_URL=https://api.example.com/api
#
# Maps Android : android/secrets.properties (gitignoré)
#   GOOGLE_MAPS_API_KEY=...
# Restreindre la clé par package + SHA-1 dans Google Cloud Console.
#
# Google Sign-In : Client ID **Web** (pas le secret).
#   GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com

API_URL=https://votre-api.example.com/api
LEGAL_BASE_URL=https://soutralideals-web-app.onrender.com
GOOGLE_MAPS_API_KEY=
GOOGLE_WEB_CLIENT_ID=
